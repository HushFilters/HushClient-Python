{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run API with uv reload",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "uvicorn",
        "api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
