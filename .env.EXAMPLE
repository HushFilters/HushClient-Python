NWEBBED_API_KEY=tsk_eccfe4c795fe_948990ae8_EXAMPLEKEY_NOTREAL_b5070b3efd5
NWEBBED_API_URL=https://tarsus.nwebbed.com/api/v1/hushfilters/credentials
# Comma-separated names for generated self-signed public certs. Replace certs in ./tls/public for production.
HUSHFILTER_PUBLIC_HOSTNAMES=localhost
# Comma-separated names for generated internal API certs. Must include hushfilter-api for nginx verification.
HUSHFILTER_INTERNAL_SERVER_NAMES=hushfilter-api,localhost
# Set to 1 to enable Test Mode
HUSHFILTER_TEST_MODE=0
# Set to 1 to enable the daily auto updater, 0 to disable it.
AUTO_UPDATE_FILTERS=1
# Integer hour in 24-hour time. Example: 23 = 11pm, 2 = 2am.
AUTO_UPDATE_TIME=23
